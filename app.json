{
  "expo": {
    "name": "GoodHealthMate",
    "slug": "meal_app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/GoodHealthMate_logo.png",
    "scheme": "mealapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goodhealthmate.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goodhealthmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#13519C",
        "foregroundImage": "./assets/images/GoodHealthMate_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/GoodHealthMate_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GoodHealthMate_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#13519C",
          "dark": {
            "backgroundColor": "#13519C"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to scan food for recognition, and to add pictures to your recipes, profile, and feedback.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan food for recognition and to take photos for your recipes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b01bf15a-f4fe-457c-bcd4-c6737ab47587"
      }
    },
    "owner": "rinty6",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b01bf15a-f4fe-457c-bcd4-c6737ab47587",
      "enabled": false
    }
  }
}
